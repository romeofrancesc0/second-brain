{
  "name": "second-brain-viewer",
  "productName": "Second Brain",
  "version": "0.1.0",
  "description": "Explore your Obsidian vault as a 3D neural network, with a local AI agent.",
  "license": "MIT",
  "homepage": "https://github.com/romeofrancesc0/second-brain#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/romeofrancesc0/second-brain.git"
  },
  "bugs": {
    "url": "https://github.com/romeofrancesc0/second-brain/issues"
  },
  "author": "Francesco Romeo",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "node scripts/fetch-llama.cjs && electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "dist": "node scripts/fetch-llama.cjs mac-arm64 mac-x64 && electron-vite build && electron-builder --mac --publish never",
    "app": "node scripts/fetch-llama.cjs mac-arm64 && electron-vite build && electron-builder --mac --dir --arm64",
    "icon": "electron scripts/make-icon.cjs",
    "app:win": "node scripts/fetch-llama.cjs win-x64 && electron-vite build && electron-builder --win --dir --x64",
    "dist:win": "node scripts/fetch-llama.cjs win-x64 && electron-vite build && electron-builder --win --publish never",
    "service": "node out/main/server.js",
    "llama": "node scripts/fetch-llama.cjs"
  },
  "build": {
    "appId": "com.francescoromeo.secondbrain",
    "productName": "Second Brain",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": [
      "out/**/*"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "darkModeSupport": true,
      "identity": "-",
      "hardenedRuntime": false,
      "artifactName": "Second-Brain-mac-${arch}.${ext}"
    },
    "electronLanguages": [
      "it",
      "en"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Second-Brain-win-${arch}.${ext}"
    },
    "extraResources": [
      {
        "from": "resources/llama/${os}-${arch}",
        "to": "llama/${os}-${arch}"
      },
      {
        "from": "resources/demo-vault",
        "to": "demo-vault"
      },
      {
        "from": "resources/THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      },
      {
        "from": "LICENSE",
        "to": "LICENSE"
      }
    ]
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/three": "^0.186.0",
    "d3-force-3d": "^3.0.6",
    "dompurify": "^3.4.17",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "katex": "^0.16.47",
    "marked": "^18.1.1",
    "marked-katex-extension": "^5.1.13",
    "three": "^0.186.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  }
}
